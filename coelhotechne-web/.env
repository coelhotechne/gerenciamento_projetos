# Desativa o plugin de ESLint embutido do react-scripts durante o build.
# Motivo: react-scripts 5 + eslint-plugin-jest resolvido nesta instalação
# geram o erro "Environment key jest/globals is unknown" (incompatibilidade
# conhecida do toolchain do Create React App, não relacionada ao código
# deste projeto). O lint continua disponível normalmente no editor.
DISABLE_ESLINT_PLUGIN=true
